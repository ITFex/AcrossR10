# Payload CMS configuration for AcrossR10
# Generated secret – NEVER commit the real value.
PAYLOAD_SECRET=YOUR_S…HERE

# Postgres (acrossr10-postgres container in the bikeracer-network)
DATABASE_URL=postgresql://cms:cms-password@acrossr10-postgres:5432/cms

# Sub-path the CMS is served under (nginx proxies /acrossr10/cms/ unchanged)
BASE_PATH=/acrossr10/cms

# Public URL (used for emails/redirects)
SERVER_URL=https://wideride.de/acrossr10/cms

PORT=3000
