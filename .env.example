# Auth.js secret - generate with: openssl rand -hex 32
AUTH_SECRET=

# Keycloak OIDC client credentials
# Create a realm "acrossr10", then a client "acrossr10-app" (Standard Flow, Confidential)
KEYCLOAK_ID=acrossr10-app
KEYCLOAK_SECRET=
KEYCLOAK_ISSUER=http://localhost:8080/realms/acrossr10

# Keycloak admin credentials (used by docker-compose) — must be set before first run
KEYCLOAK_ADMIN=
KEYCLOAK_ADMIN_PASSWORD=

# Postgres password for Keycloak (used by docker-compose)
POSTGRES_PASSWORD=keycloak

# Directory for the SQLite leaderboard database (defaults to <cwd>/data when not set)
DATA_PATH=/data
