      <trkpt lat="50.9180" lon="10.5170"><ele>610</ele></trkpt>
      <trkpt lat="50.9050" lon="10.5430"><ele>690</ele></trkpt>
      <!-- Rennsteig-Höhe um Eisenach -->
      <trkpt lat="50.8920" lon="10.5780"><ele>760</ele></trkpt>
      <trkpt lat="50.8780" lon="10.6050"><ele>820</ele></trkpt>
      <trkpt lat="50.8640" lon="10.6340"><ele>870</ele></trkpt>
