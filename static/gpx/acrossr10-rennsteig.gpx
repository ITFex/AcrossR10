  <metadata>
    <name>AcrossR10 – Rennsteig Gravel Querung</name>
    <desc>Gravelroute über den Rennsteig von Hörschel (Eisenach) bis Blankenstein. Ca. 170 km, 3.200 Hm.</desc>
    <author><name>AcrossR10</name></author>
    <copyright author="AcrossR10"><year>2026</year></copyright>
    <link href="https://wideride.de/acrossr10"><text>AcrossR10</text></link>
    <time>2026-01-01T00:00:00Z</time>
    <keywords>Rennsteig, Gravel, Thüringen, Thüringer Wald</keywords>
    <bounds minlat="50.3498" minlon="10.3951" maxlat="50.9773" maxlon="11.6889"/>
  </metadata>
  <trk>
    <name>AcrossR10 Rennsteig</name>
    <desc>Gravelroute entlang des Rennsteigs</desc>
    <trkseg>
      <!-- Hörschel (Start) -->
      <trkpt lat="50.9773" lon="10.3951"><ele>230</ele></trkpt>
      <trkpt lat="50.9620" lon="10.4220"><ele>310</ele></trkpt>
      <trkpt lat="50.9490" lon="10.4510"><ele>420</ele></trkpt>
      <!-- Rennsteigkuppe Wartburgkreis -->
