      <trkpt lat="50.8100" lon="10.7530"><ele>780</ele></trkpt>
      <trkpt lat="50.7950" lon="10.7890"><ele>750</ele></trkpt>
      <trkpt lat="50.7820" lon="10.8220"><ele>820</ele></trkpt>
      <!-- Oberhof Bereich -->
      <trkpt lat="50.7060" lon="10.7340"><ele>910</ele></trkpt>
      <trkpt lat="50.6910" lon="10.7580"><ele>930</ele></trkpt>
      <trkpt lat="50.6760" lon="10.7820"><ele>880</ele></trkpt>
      <!-- Schwarzatal -->
      <trkpt lat="50.6600" lon="10.8090"><ele>820</ele></trkpt>
      <trkpt lat="50.6440" lon="10.8370"><ele>790</ele></trkpt>
      <trkpt lat="50.6290" lon="10.8640"><ele>810</ele></trkpt>
      <!-- Masserberg -->
      <trkpt lat="50.6110" lon="10.8920"><ele>850</ele></trkpt>
