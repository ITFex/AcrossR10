      <trkpt lat="50.5490" lon="11.0150"><ele>790</ele></trkpt>
      <trkpt lat="50.5330" lon="11.0460"><ele>760</ele></trkpt>
      <!-- Rennsteigbaude -->
      <trkpt lat="50.5180" lon="11.0780"><ele>780</ele></trkpt>
